{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/public/Home.html" },

    { "source": "/schools", "destination": "/public/Schools.html" },
    { "source": "/admissions", "destination": "/public/Admissions.html" },
    { "source": "/exams", "destination": "/public/Exams.html" },
    { "source": "/scholarships", "destination": "/public/Scholarships.html" },
    { "source": "/trending", "destination": "/public/Trending.html" },

    { "source": "/admin", "destination": "/public/admin/login.html" },
    { "source": "/admin/login", "destination": "/public/admin/login.html" },
    { "source": "/admin/dashboard", "destination": "/public/admin/dashboard.html" },
    { "source": "/admin/schools", "destination": "/public/admin/Schools.html" },
    { "source": "/admin/admissions", "destination": "/public/admin/Admissions.html" },
    { "source": "/admin/exams", "destination": "/public/admin/Exams.html" },
    { "source": "/admin/scholarships", "destination": "/public/admin/Scholarships.html" },
    { "source": "/admin/trending", "destination": "/public/admin/Trending.html" },
    { "source": "/admin/media", "destination": "/public/admin/Media.html" },
    { "source": "/admin/users", "destination": "/public/admin/Users.html" },
    { "source": "/admin/audit", "destination": "/public/admin/Audit.html" },
    { "source": "/admin/settings", "destination": "/public/admin/Settings.html" },
    { "source": "/admin/advertisements", "destination": "/public/admin/Advertisements.html" },

    { "source": "/SchoolAd", "destination": "/public/SchoolAd/login.html" },
    { "source": "/SchoolAd/login", "destination": "/public/SchoolAd/login.html" },
    { "source": "/SchoolAd/index", "destination": "/public/SchoolAd/index.html" },
    { "source": "/SchoolAd/courses", "destination": "/public/SchoolAd/courses.html" },
    { "source": "/SchoolAd/fees", "destination": "/public/SchoolAd/fees.html" },
    { "source": "/SchoolAd/admissions", "destination": "/public/SchoolAd/admissions.html" },
    { "source": "/SchoolAd/calendar", "destination": "/public/SchoolAd/calendar.html" },
    { "source": "/SchoolAd/media", "destination": "/public/SchoolAd/media.html" },
    { "source": "/SchoolAd/submissions", "destination": "/public/SchoolAd/submissions.html" },
    { "source": "/SchoolAd/profile", "destination": "/public/SchoolAd/profile.html" },

    { "source": "/Advertiser", "destination": "/public/Advertiser/login.html" },
    { "source": "/advertiser", "destination": "/public/Advertiser/login.html" },
    { "source": "/Advertiser/login", "destination": "/public/Advertiser/login.html" },
    { "source": "/Advertiser/dashboard", "destination": "/public/Advertiser/Index.html" },
    { "source": "/Advertiser/campaigns", "destination": "/public/Advertiser/campaigns.html" },
    { "source": "/Advertiser/create", "destination": "/public/Advertiser/Create Campaigns.html" },
    { "source": "/Advertiser/create-campaigns", "destination": "/public/Advertiser/Create Campaigns.html" },
    { "source": "/Advertiser/analytics", "destination": "/public/Advertiser/Analytics.html" },
    { "source": "/Advertiser/billing", "destination": "/public/Advertiser/Billing.html" },
    { "source": "/Advertiser/payments", "destination": "/public/Advertiser/Billing.html" },
    { "source": "/Advertiser/profile", "destination": "/public/Advertiser/Profile.html" },
    { "source": "/Advertiser/notifications", "destination": "/public/Advertiser/Notifications.html" },
    { "source": "/Advertiser/support", "destination": "/public/Advertiser/Support.html" },
    { "source": "/Advertiser/settings", "destination": "/public/Advertiser/Settings.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/SchoolAd/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/Advertiser/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}