{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/", "destination": "/Home" },
    { "source": "/schools", "destination": "/Schools" },
    { "source": "/admissions", "destination": "/Admissions" },
    { "source": "/exams", "destination": "/Exams" },
    { "source": "/scholarships", "destination": "/Scholarships" },
    { "source": "/trending", "destination": "/Trending" },

    { "source": "/admin", "destination": "/admin/login" },
    { "source": "/admin/login", "destination": "/admin/login" },
    { "source": "/admin/dashboard", "destination": "/admin/dashboard" },
    { "source": "/admin/schools", "destination": "/admin/Schools" },
    { "source": "/admin/admissions", "destination": "/admin/Admissions" },
    { "source": "/admin/exams", "destination": "/admin/Exams" },
    { "source": "/admin/scholarships", "destination": "/admin/Scholarships" },
    { "source": "/admin/trending", "destination": "/admin/Trending" },
    { "source": "/admin/media", "destination": "/admin/Media" },
    { "source": "/admin/users", "destination": "/admin/Users" },
    { "source": "/admin/audit", "destination": "/admin/Audit" },
    { "source": "/admin/settings", "destination": "/admin/Settings" },
    { "source": "/admin/advertisements", "destination": "/admin/advertisements" },

    { "source": "/SchoolAd", "destination": "/SchoolAd/login" },
    { "source": "/SchoolAd/login", "destination": "/SchoolAd/login" },
    { "source": "/SchoolAd/index", "destination": "/SchoolAd/index" },
    { "source": "/SchoolAd/courses", "destination": "/SchoolAd/courses" },
    { "source": "/SchoolAd/fees", "destination": "/SchoolAd/fees" },
    { "source": "/SchoolAd/admissions", "destination": "/SchoolAd/admissions" },
    { "source": "/SchoolAd/calendar", "destination": "/SchoolAd/calendar" },
    { "source": "/SchoolAd/media", "destination": "/SchoolAd/media" },
    { "source": "/SchoolAd/submissions", "destination": "/SchoolAd/submissions" },
    { "source": "/SchoolAd/profile", "destination": "/SchoolAd/profile" },

    { "source": "/Advertiser", "destination": "/Advertiser/login" },
    { "source": "/Advertiser/login", "destination": "/Advertiser/login" },
    { "source": "/Advertiser/dashboard", "destination": "/Advertiser/Index" },
    { "source": "/Advertiser/campaigns", "destination": "/Advertiser/campaigns" },
    { "source": "/Advertiser/create", "destination": "/Advertiser/Create Campaigns" },
    { "source": "/Advertiser/create-campaigns", "destination": "/Advertiser/Create Campaigns" },
    { "source": "/Advertiser/analytics", "destination": "/Advertiser/Analytics" },
    { "source": "/Advertiser/billing", "destination": "/Advertiser/Billing" },
    { "source": "/Advertiser/payments", "destination": "/Advertiser/Billing" },
    { "source": "/Advertiser/profile", "destination": "/Advertiser/Profile" },
    { "source": "/Advertiser/notifications", "destination": "/Advertiser/Notifications" },
    { "source": "/Advertiser/support", "destination": "/Advertiser/Support" },
    { "source": "/Advertiser/settings", "destination": "/Advertiser/Settings" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/SchoolAd/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/Advertiser/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}