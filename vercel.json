{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "rewrites": [
    { "source": "/",              "destination": "/Home" },
    { "source": "/schools",       "destination": "/Schools" },
    { "source": "/admissions",    "destination": "/Admissions" },
    { "source": "/exams",         "destination": "/Exams" },
    { "source": "/scholarships",  "destination": "/Scholarships" },
    { "source": "/trending",      "destination": "/Trending" },

    { "source": "/admin",         "destination": "/admin/login.html" },
    { "source": "/admin/",        "destination": "/admin/login.html" },
    { "source": "/admin/login",   "destination": "/admin/login.html" },
    { "source": "/admin/Login",   "destination": "/admin/login.html" },
    { "source": "/admin/Schools", "destination": "/admin/Schools.html" },
    { "source": "/admin/Admissions","destination": "/admin/Admissions.html" },
    { "source": "/admin/Exams",   "destination": "/admin/Exams.html" },
    { "source": "/admin/Scholarships","destination": "/admin/Scholarships.html" },
    { "source": "/admin/Trending","destination": "/admin/Trending.html" },
    { "source": "/admin/Media",   "destination": "/admin/Media.html" },
    { "source": "/admin/Users",   "destination": "/admin/Users.html" },
    { "source": "/admin/Audit",   "destination": "/admin/Audit.html" },
    { "source": "/admin/Settings","destination": "/admin/Settings.html" },

    { "source": "/SchoolAd",            "destination": "/SchoolAd/login.html" },
    { "source": "/SchoolAd/",           "destination": "/SchoolAd/login.html" },
    { "source": "/SchoolAd/login",      "destination": "/SchoolAd/login.html" },
    { "source": "/SchoolAd/Login",      "destination": "/SchoolAd/login.html" },
    { "source": "/SchoolAd/index",      "destination": "/SchoolAd/index.html" },
    { "source": "/SchoolAd/courses",    "destination": "/SchoolAd/courses.html" },
    { "source": "/SchoolAd/fees",       "destination": "/SchoolAd/fees.html" },
    { "source": "/SchoolAd/admissions", "destination": "/SchoolAd/admissions.html" },
    { "source": "/SchoolAd/calendar",   "destination": "/SchoolAd/calendar.html" },
    { "source": "/SchoolAd/media",      "destination": "/SchoolAd/media.html" },
    { "source": "/SchoolAd/submissions","destination": "/SchoolAd/submissions.html" },
    { "source": "/SchoolAd/profile",    "destination": "/SchoolAd/profile.html" },
    { "source": "/SchoolAd/:path*",     "destination": "/SchoolAd/:path*.html" },

    { "source": "/Advertiser",                   "destination": "/Advertiser/login.html" },
    { "source": "/Advertiser/",                  "destination": "/Advertiser/login.html" },
    { "source": "/Advertiser/login",             "destination": "/Advertiser/login.html" },
    { "source": "/Advertiser/Login",             "destination": "/Advertiser/login.html" },
    { "source": "/Advertiser/index",             "destination": "/Advertiser/Index.html" },
    { "source": "/Advertiser/Index",             "destination": "/Advertiser/Index.html" },
    { "source": "/Advertiser/dashboard",         "destination": "/Advertiser/Index.html" },
    { "source": "/Advertiser/campaigns",         "destination": "/Advertiser/campaigns.html" },
    { "source": "/Advertiser/Campaigns",         "destination": "/Advertiser/campaigns.html" },
    { "source": "/Advertiser/create",            "destination": "/Advertiser/Create Campaigns.html" },
    { "source": "/Advertiser/create-campaigns",  "destination": "/Advertiser/Create Campaigns.html" },
    { "source": "/Advertiser/Create%20Campaigns","destination": "/Advertiser/Create Campaigns.html" },
    { "source": "/Advertiser/analytics",         "destination": "/Advertiser/Analytics.html" },
    { "source": "/Advertiser/Analytics",         "destination": "/Advertiser/Analytics.html" },
    { "source": "/Advertiser/billing",           "destination": "/Advertiser/Billing.html" },
    { "source": "/Advertiser/Billing",           "destination": "/Advertiser/Billing.html" },
    { "source": "/Advertiser/payments",          "destination": "/Advertiser/Billing.html" },
    { "source": "/Advertiser/profile",           "destination": "/Advertiser/Profile.html" },
    { "source": "/Advertiser/Profile",           "destination": "/Advertiser/Profile.html" },
    { "source": "/Advertiser/notifications",     "destination": "/Advertiser/Notifications.html" },
    { "source": "/Advertiser/Notifications",     "destination": "/Advertiser/Notifications.html" },
    { "source": "/Advertiser/support",           "destination": "/Advertiser/Support.html" },
    { "source": "/Advertiser/Support",           "destination": "/Advertiser/Support.html" },
    { "source": "/Advertiser/settings",          "destination": "/Advertiser/Settings.html" },
    { "source": "/Advertiser/Settings",          "destination": "/Advertiser/Settings.html" },

    { "source": "/advertiser",                   "destination": "/Advertiser/login.html" },
    { "source": "/advertiser/",                  "destination": "/Advertiser/login.html" },
    { "source": "/advertiser/login",             "destination": "/Advertiser/login.html" },
    { "source": "/advertiser/dashboard",         "destination": "/Advertiser/Index.html" },
    { "source": "/advertiser/campaigns",         "destination": "/Advertiser/campaigns.html" },
    { "source": "/advertiser/create",            "destination": "/Advertiser/Create Campaigns.html" },
    { "source": "/advertiser/create-campaigns",  "destination": "/Advertiser/Create Campaigns.html" },
    { "source": "/advertiser/analytics",         "destination": "/Advertiser/Analytics.html" },
    { "source": "/advertiser/billing",           "destination": "/Advertiser/Billing.html" },
    { "source": "/advertiser/payments",          "destination": "/Advertiser/Billing.html" },
    { "source": "/advertiser/profile",           "destination": "/Advertiser/Profile.html" },
    { "source": "/advertiser/notifications",     "destination": "/Advertiser/Notifications.html" },
    { "source": "/advertiser/support",           "destination": "/Advertiser/Support.html" },
    { "source": "/advertiser/settings",          "destination": "/Advertiser/Settings.html" },

    { "source": "/Advertiser/:path*",            "destination": "/Advertiser/:path*.html" },
    { "source": "/advertiser/:path*",            "destination": "/Advertiser/:path*.html" },

    { "source": "/((?!api/).*)", "destination": "/404" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy",        "value": "strict-origin-when-cross-origin" }
      ]
    },
    { "source": "/admin/(.*)",      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/admin",           "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/SchoolAd/(.*)",   "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/SchoolAd",        "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/Advertiser/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/Advertiser",      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/advertiser/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] },
    { "source": "/advertiser",      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ]
}